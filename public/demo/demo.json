    { "id": "0", "start": 0, "end": 4.05, "speaker": "Speaker", "en": "Welcome to Listening Desk, a small place for slow and careful listening.", "zh": "欢迎来到听译台，一个适合慢下来、认真聆听的小空间。", "words": [{"text":" Welcome","start":0,"end":0.3},{"text":" to","start":0.3,"end":0.54},{"text":" Listening","start":0.54,"end":0.84},{"text":" Desk,","start":0.84,"end":1.42},{"text":" a","start":1.6,"end":1.72},{"text":" small","start":1.72,"end":1.96},{"text":" place","start":1.96,"end":2.3},{"text":" for","start":2.3,"end":2.54},{"text":" slow","start":2.54,"end":2.82},{"text":" and","start":2.82,"end":2.96},{"text":" careful","start":2.96,"end":3.3},{"text":" listening.","start":3.3,"end":3.84}] },
    { "id": "1", "start": 4.05, "end": 7.86, "speaker": "Speaker", "en": "A podcast can carry an idea across the world in a single afternoon.", "zh": "一档播客可以在一个下午，把一种思想带到世界另一端。", "words": [{"text":" A","start":4.04,"end":4.14},{"text":" podcast","start":4.14,"end":4.5},{"text":" can","start":4.5,"end":4.88},{"text":" carry","start":4.88,"end":5.18},{"text":" an","start":5.18,"end":5.36},{"text":" idea","start":5.36,"end":5.66},{"text":" across","start":5.66,"end":6},{"text":" the","start":6,"end":6.26},{"text":" world","start":6.26,"end":6.5},{"text":" in","start":6.5,"end":6.66},{"text":" a","start":6.66,"end":6.78},{"text":" single","start":6.78,"end":7.04},{"text":" afternoon.","start":7.04,"end":7.66}] },
    { "id": "2", "start": 7.86, "end": 10.97, "speaker": "Speaker", "en": "But language often stands between the speaker and the listener.", "zh": "但语言往往隔在讲述者与听众之间。", "words": [{"text":" But","start":7.86,"end":7.98},{"text":" language","start":7.98,"end":8.32},{"text":" often","start":8.32,"end":8.72},{"text":" stands","start":8.72,"end":9.06},{"text":" between","start":9.06,"end":9.54},{"text":" the","start":9.54,"end":9.78},{"text":" speaker","start":9.78,"end":10.08},{"text":" and","start":10.08,"end":10.34},{"text":" the","start":10.34,"end":10.46},{"text":" listener.","start":10.46,"end":10.8}] },
    { "id": "3", "start": 10.97, "end": 15.09, "speaker": "Speaker", "en": "This player keeps the original sentence and its Chinese translation together.", "zh": "这个播放器让英文原句与中文翻译始终并排呈现。", "words": [{"text":" This","start":10.98,"end":11.14},{"text":" player","start":11.14,"end":11.44},{"text":" keeps","start":11.44,"end":11.78},{"text":" the","start":11.78,"end":12},{"text":" original","start":12,"end":12.42},{"text":" sentence","start":12.42,"end":12.84},{"text":" and","start":12.84,"end":13.16},{"text":" its","start":13.16,"end":13.34},{"text":" Chinese","start":13.34,"end":13.68},{"text":" translation","start":13.68,"end":14.44},{"text":" together.","start":14.44,"end":14.84}] },
    { "id": "4", "start": 15.09, "end": 19.16, "speaker": "Speaker", "en": "As the voice moves forward, the current passage follows the playback head.", "zh": "随着声音向前，当前字幕会跟随播放进度移动。", "words": [{"text":" As","start":15.1,"end":15.22},{"text":" the","start":15.22,"end":15.36},{"text":" voice","start":15.36,"end":15.6},{"text":" moves","start":15.6,"end":15.9},{"text":" forward,","start":15.9,"end":16.34},{"text":" the","start":16.72,"end":16.84},{"text":" current","start":16.84,"end":17.16},{"text":" passage","start":17.16,"end":17.56},{"text":" follows","start":17.56,"end":18.04},{"text":" the","start":18.04,"end":18.3},{"text":" playback","start":18.3,"end":18.62},{"text":" head.","start":18.62,"end":19.06}] },
    { "id": "5", "start": 19.16, "end": 22.37, "speaker": "Speaker", "en": "You can select any sentence to return to that exact moment.", "zh": "你可以点击任意一句，回到它出现的准确时刻。", "words": [{"text":" You","start":19.18,"end":19.28},{"text":" can","start":19.28,"end":19.46},{"text":" select","start":19.46,"end":19.8},{"text":" any","start":19.8,"end":20.06},{"text":" sentence","start":20.06,"end":20.42},{"text":" to","start":20.42,"end":20.74},{"text":" return","start":20.74,"end":21.08},{"text":" to","start":21.08,"end":21.26},{"text":" that","start":21.26,"end":21.44},{"text":" exact","start":21.44,"end":21.76},{"text":" moment.","start":21.76,"end":22.2}] },
    { "id": "6", "start": 22.37, "end": 25.05, "speaker": "Speaker", "en": "Import your own episode when you are ready to begin.", "zh": "准备好之后，就导入你自己的播客开始吧。", "words": [{"text":" Import","start":22.36,"end":22.64},{"text":" your","start":22.64,"end":22.9},{"text":" own","start":22.9,"end":23.1},{"text":" episode","start":23.1,"end":23.52},{"text":" when","start":23.52,"end":23.84},{"text":" you","start":23.84,"end":24},{"text":" are","start":24,"end":24.14},{"text":" ready","start":24.14,"end":24.38},{"text":" to","start":24.38,"end":24.56},{"text":" begin.","start":24.56,"end":24.82}] }
